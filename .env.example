# Copy to .env for local use. On Render, set these in the dashboard instead.
ADMIN_EMAIL=admin@royalsgym.in
# Generate with: npm run hash-password -- "YourPassword"   (never store the plain password)
ADMIN_PASSWORD_HASH='$argon2id$...'
# Random 64+ char string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First month fees are tracked from (YYYY-MM). Defaults to 2026-01.
FEES_START_MONTH=2026-01
# Append-only Google Sheet backup (see google-apps-script/Code.gs). Leave empty to turn off.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# From Neon (or any Postgres). Leave empty locally to use a throwaway in-memory DB.
DATABASE_URL=
